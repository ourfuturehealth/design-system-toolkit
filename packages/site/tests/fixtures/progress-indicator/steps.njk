{% from 'progress-indicator/macro.njk' import progressIndicator %}

{% for currentStep in [10, 5, 2, 1, 0.5, 0, -1] %}
<div data-current-step="{{ currentStep }}">
  {{ progressIndicator({
    currentStep: currentStep,
    totalSteps: 5,
    label: 'Personal details'
  }) }}
</div>
{% endfor %}

{% for label in ['Personal details', '', null] %}
<div data-label-case="{{ loop.index }}">
  {{ progressIndicator({
    currentStep: 2,
    totalSteps: 8,
    label: label,
    helperText: 'About 5 minutes left'
  }) }}
</div>
{% endfor %}

{% for totalSteps in [1, 3, 8, 0, -3, 4.4, 4.6] %}
<div data-total-steps="{{ totalSteps }}">
  {{ progressIndicator({
    currentStep: 2,
    totalSteps: totalSteps
  }) }}
</div>
{% endfor %}

{% for subSegmentProgress in [-25, 0, 40, 100, 125] %}
<div data-sub-segment-progress="{{ subSegmentProgress }}">
  {{ progressIndicator({
    currentStep: 2,
    totalSteps: 8,
    subSegmentProgress: subSegmentProgress
  }) }}
</div>
{% endfor %}

{% for showBars in [true, false] %}
<div data-show-bars="{{ showBars }}">
  {{ progressIndicator({
    currentStep: 2,
    totalSteps: 5,
    showBars: showBars,
    classes: 'custom-progress extra-progress',
    attributes: { 'data-tracking': 'progress' }
  }) }}
</div>
{% endfor %}

<div data-generated-progress>
  {{ progressIndicator({
    currentStep: 11,
    totalSteps: 12
  }) }}
</div>

{% for progressCase in [[2, 50], [2, 100], [8, 50]] %}
<div data-step-partial-case="{{ loop.index }}">
  {{ progressIndicator({
    currentStep: progressCase[0],
    totalSteps: 8,
    subSegmentProgress: progressCase[1]
  }) }}
</div>
{% endfor %}

{% for label in ['Personal details', null, '', '   ', ' Personal details '] %}
<div data-announcement-case="{{ loop.index }}">
  {{ progressIndicator({
    currentStep: 2,
    totalSteps: 8,
    label: label
  }) }}
</div>
{% endfor %}
