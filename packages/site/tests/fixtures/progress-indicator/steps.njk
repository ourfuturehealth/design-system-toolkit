{% from 'progress-indicator/macro.njk' import progressIndicator %}

{% for currentStep in [10, 5, 2, 1, 0.5, 0, -1] %}
<div data-current-step="{{ currentStep }}">
  {{ progressIndicator({
    currentStep: currentStep,
    totalSteps: 5,
    label: 'Personal details'
  }) }}
</div>
{% endfor %}

{% for label in ['Personal details', '', null] %}
<div data-label-case="{{ loop.index }}">
  {{ progressIndicator({
    currentStep: 2,
    totalSteps: 8,
    label: label,
    helperText: 'About 5 minutes left'
  }) }}
</div>
{% endfor %}

<div data-percentage>
  {{ progressIndicator({
    progressState: 40,
    totalSegments: 5,
    subSegmentProgress: 50,
    progressText: 'Custom progress text'
  }) }}
</div>

<div data-percentage-page>
  {{ progressIndicator({
    progressState: 25,
    totalSegments: 8,
    label: 'Personal details',
    progressText: 'Page 2 of 8'
  }) }}
</div>

<div data-percentage-without-text>
  {{ progressIndicator({
    progressState: 40,
    totalSegments: 5
  }) }}
</div>

{% for totalSteps in [1, 3, 8, 0, -3, 4.4, 4.6] %}
<div data-total-steps="{{ totalSteps }}">
  {{ progressIndicator({
    currentStep: 2,
    totalSteps: totalSteps
  }) }}
</div>
{% endfor %}

{% for progressState in [-25, 0, 25, 100, 125] %}
<div data-progress-state="{{ progressState }}">
  {{ progressIndicator({
    progressState: progressState,
    totalSegments: 8
  }) }}
</div>
{% endfor %}

{% for subSegmentProgress in [-25, 0, 40, 100, 125] %}
<div data-sub-segment-progress="{{ subSegmentProgress }}">
  {{ progressIndicator({
    progressState: 25,
    totalSegments: 8,
    subSegmentProgress: subSegmentProgress
  }) }}
</div>
{% endfor %}

{% for showBars in [true, false] %}
<div data-show-bars="{{ showBars }}">
  {{ progressIndicator({
    currentStep: 2,
    totalSteps: 5,
    showBars: showBars,
    classes: 'custom-progress extra-progress',
    attributes: { 'data-tracking': 'progress' }
  }) }}
</div>
{% endfor %}

<div data-step-precedence>
  {{ progressIndicator({
    currentStep: 10,
    totalSteps: 5,
    progressState: 25,
    totalSegments: 8,
    progressText: 'Page 10 of 5'
  }) }}
</div>
