{% set progressState = 0 if params.progressState < 0 else (100 if params.progressState > 100 else params.progressState) %}
{% set totalSegments = 1 if params.totalSegments < 1 else params.totalSegments | round %}
{% set filledSegments = (progressState / 100 * totalSegments) | round %}
<div class="ofh-progress-indicator{% if params.classes %} {{ params.classes }}{% endif %}"{% for attribute, value in params.attributes %} {{ attribute }}="{{ value }}"{% endfor %}>
  {% if params.label or params.progressText %}
  <div class="ofh-progress-indicator__header">
    {% if params.label %}
    <span class="ofh-progress-indicator__label">{{ params.label }}</span>
    {% endif %}
    {% if params.progressText %}
    <span class="ofh-progress-indicator__steps">{{ params.progressText }}</span>
    {% endif %}
  </div>
  {% endif %}
  <div
    class="ofh-progress-indicator__track{% if params.showBars == false %} ofh-progress-indicator__track--without-bars{% endif %}"
    role="progressbar"
    aria-valuenow="{{ progressState }}"
    aria-valuemin="0"
    aria-valuemax="100"
    aria-valuetext="{{ progressState }}%"
    aria-label="{{ params.label + ': ' if params.label else '' }}{{ progressState }}%"
  >
    {% for segment in range(0, totalSegments) %}
    <span class="ofh-progress-indicator__segment{% if segment < filledSegments %} ofh-progress-indicator__segment--filled{% endif %}"></span>
    {% endfor %}
  </div>
  {% if params.helperText %}
  <span class="ofh-progress-indicator__helper">{{ params.helperText }}</span>
  {% endif %}
</div>
