{% set accessibleLabel = params.label | default('', true) | trim %}
{% set requestedSubSegmentProgress = params.subSegmentProgress | default(0) %}
{% set subSegmentProgress = 0 if requestedSubSegmentProgress < 0 else (100 if requestedSubSegmentProgress > 100 else requestedSubSegmentProgress) %}
{% set usesSteps = params.currentStep is defined and params.totalSteps is defined %}
{% if usesSteps %}
{% set totalSegments = 1 if params.totalSteps < 1 else params.totalSteps | round %}
{% set progressState = 1 if params.currentStep < 1 else (totalSegments if params.currentStep > totalSegments else params.currentStep) %}
{% set requestedProgress = progressState + subSegmentProgress / 100 %}
{% set overallProgress = totalSegments if requestedProgress > totalSegments else requestedProgress %}
{% set scaledProgress = overallProgress * 100 %}
{% set progressMin = 1 %}
{% set progressMax = totalSegments %}
{% set progressText = 'Page ' + (overallProgress | round(0, 'ceil')) + ' of ' + totalSegments %}
{% set valueText = progressText if overallProgress == (overallProgress | round(0, 'floor')) else overallProgress + ' of ' + totalSegments + ' steps complete' %}
{% else %}
{% set progressState = 1 if params.progressState < 1 else (100 if params.progressState > 100 else params.progressState) %}
{% set totalSegments = 1 if params.totalSegments < 1 else params.totalSegments | round %}
{% set requestedProgress = progressState + subSegmentProgress / totalSegments %}
{% set overallProgress = 100 if requestedProgress > 100 else requestedProgress %}
{% set scaledProgress = overallProgress * totalSegments %}
{% set progressMin = 1 %}
{% set progressMax = 100 %}
{% set progressText = params.progressText %}
{% set requestedValueText = progressText | default('', true) | trim %}
{% set valueText = requestedValueText if requestedValueText else overallProgress + '%' %}
{% endif %}
{% set filledSegments = (scaledProgress / 100) | round(0, 'floor') %}
{% set segmentProgress = scaledProgress - filledSegments * 100 %}
<div class="ofh-progress-indicator{% if params.classes %} {{ params.classes }}{% endif %}"{% for attribute, value in params.attributes %} {{ attribute }}="{{ value }}"{% endfor %}>
  <div
    role="progressbar"
    aria-valuenow="{{ overallProgress }}"
    aria-valuemin="{{ progressMin }}"
    aria-valuemax="{{ progressMax }}"
    aria-valuetext="{{ valueText }}"
    aria-label="{{ accessibleLabel if accessibleLabel else 'Progress' }}"
  >
    {% if params.label or progressText %}
    <div class="ofh-progress-indicator__header" aria-hidden="true">
      {% if params.label %}
      <span class="ofh-progress-indicator__label">{{ params.label }}</span>
      {% endif %}
      {% if progressText %}
      <span class="ofh-progress-indicator__steps">{{ progressText }}</span>
      {% endif %}
    </div>
    {% endif %}
    <div class="ofh-progress-indicator__track{% if params.showBars == false %} ofh-progress-indicator__track--without-bars{% endif %}" aria-hidden="true">
      {% for segment in range(0, totalSegments) %}
      <span class="ofh-progress-indicator__segment{% if segment < filledSegments %} ofh-progress-indicator__segment--filled{% endif %}">
        {% if segment == filledSegments and filledSegments < totalSegments %}
        <span class="ofh-progress-indicator__segment-progress" style="width: {{ segmentProgress }}%;"></span>
        {% endif %}
      </span>
      {% endfor %}
    </div>
  </div>
  {% if params.helperText %}
  <span class="ofh-progress-indicator__helper">{{ params.helperText }}</span>
  {% endif %}
</div>
