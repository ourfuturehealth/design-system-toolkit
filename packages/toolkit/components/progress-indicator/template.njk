<div class="ofh-progress-indicator{% if params.classes %} {{ params.classes }}{% endif %}"{% for attribute, value in params.attributes %} {{ attribute }}="{{ value }}"{% endfor %}>
  <div class="ofh-progress-indicator__header">
    {% if params.label %}
    <span class="ofh-progress-indicator__label">{{ params.label }}</span>
    {% endif %}
    <span class="ofh-progress-indicator__steps">Page {{ params.currentStep }} of {{ params.totalSteps }}</span>
  </div>
  <div
    class="ofh-progress-indicator__track"
    role="progressbar"
    aria-valuenow="{{ params.currentStep }}"
    aria-valuemin="0"
    aria-valuemax="{{ params.totalSteps }}"
    aria-valuetext="Page {{ params.currentStep }} of {{ params.totalSteps }}"
  >
    {% for step in range(0, params.totalSteps) %}
    <span class="ofh-progress-indicator__segment{% if step < params.currentStep %} ofh-progress-indicator__segment--filled{% endif %}"></span>
    {% endfor %}
  </div>
  {% if params.helperText %}
  <span class="ofh-progress-indicator__helper">{{ params.helperText }}</span>
  {% endif %}
</div>
